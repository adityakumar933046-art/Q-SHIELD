FROM python:3.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends     build-essential     curl     libpq-dev     && rm -rf /var/lib/apt/lists/*

# Copy python dependencies definition
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application source code
COPY backend/ ./backend/
COPY docs/ ./docs/

# Set Python path
ENV PYTHONPATH=/app/backend

# Create non-root runner user
RUN useradd -m -u 1000 qshield && chown -R qshield:qshield /app
USER qshield

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
