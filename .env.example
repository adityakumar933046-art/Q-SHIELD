# Q-SHIELD Production Environment Template
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO GIT!

# Environment mode (development / production)
ENVIRONMENT=production

# Database Configuration
DATABASE_URL=postgresql://qshield_user:qshield_secure_password@localhost:5432/qshield

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security & Token Signing Key (Must be strong SHA-256 random hex string in production)
SECRET_KEY=change_this_to_a_secure_random_production_secret_key_64chars

# CORS Origin Whitelist (Comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost/api/v1
