# Q-SHIELD Environment Configuration Template

DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-key-placeholder
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for local development)
USE_POSTGRES=False
DATABASE_URL=postgres://user:password@localhost:5432/qshield_db

# Q-SHIELD Non-ML Statistical Physics Thresholds
QBER_THRESHOLD=0.11
FIDELITY_THRESHOLD=0.85
CHI_SQUARE_ALPHA=0.05
MAX_FORGERY_PROBABILITY_THRESHOLD=0.05

# CORS Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
