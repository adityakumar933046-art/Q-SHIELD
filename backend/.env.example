DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL default, falls back to SQLite)
DATABASE_URL=postgres://qshield_user:qshield_password@localhost:5432/qshield_db
USE_POSTGRES=False

# Q-SHIELD Threat Detection Engine Defaults
QBER_THRESHOLD=0.11
FIDELITY_THRESHOLD=0.85
CHI_SQUARE_ALPHA=0.05
MAX_FORGERY_PROBABILITY_THRESHOLD=0.05

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
